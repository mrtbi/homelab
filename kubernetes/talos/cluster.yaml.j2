---
# yaml-language-server: $schema=https://raw.githubusercontent.com/siderolabs/talos/refs/heads/release-1.14/website/content/v1.14/schemas/config.schema.json
version: v1alpha1
machine:
  ca:
    crt: {{ ENV.MACHINE_CA_CRT }}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: false
      resolveMemberNames: true
    rbac: true
  token: {{ ENV.MACHINE_TOKEN }}
cluster:
  token: {{ ENV.CLUSTER_TOKEN }}
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: {{ ENV.CLUSTER_ID }}
clusterSecret: {{ ENV.CLUSTER_SECRET }}
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: primary
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: drbd
parameters:
  - usermode_helper=disabled
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: drbd_transport_tcp
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_thin_pool
---
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: main
endpoint: https://api.k8s.internal:6443
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
    - 10.244.0.0/16
serviceSubnets:
    - 10.96.0.0/12
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:{{ k8s_version }}
config:
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  maxPods: 200
  serializeImagePulls: false
  shutdownGracePeriod: 120s
  shutdownGracePeriodCriticalPods: 60s
extraArgs:
  rotate-server-certificates: true
defaultRuntimeSeccompProfileEnabled: true
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 172.16.1.0/24
---
apiVersion: v1alpha1
kind: StaticHostConfig
name: 172.16.1.230
hostnames:
  - api.k8s.internal
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
    disableDefault: true
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  maxSize: 80GiB