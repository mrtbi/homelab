---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer/{{ schematic }}:{{ talos_version }}
provisioning:
    diskSelector:
      match: disk.model == "TS240GMTS420S"
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: alpha.k8s.internal
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: enp1s0
clientIdentifier: mac